{
  "name": "lyramd",
  "version": "1.3.8",
  "description": "Lyra's agent-native Markdown editor",
  "main": "dist/main/index.js",
  "author": "Cherry Xiao",
  "license": "MIT",
  "homepage": "https://github.com/Afeng01/LyraMD",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afeng01/LyraMD.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "build": "electron-vite build",
    "check:themes": "node scripts/check-theme-colors.mjs",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@milkdown/kit": "^7.19.2",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.3",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "prosemirror-search": "^1.1.0",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
